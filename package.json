{
  "name": "vibe-game",
  "version": "0.1.0",
  "private": true,
  "description": "Koop Tower Defense für 3 Spieler — vibe-coded by 3 devs",
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "dev:server": "pnpm --filter @vibe-game/server dev",
    "dev:client": "pnpm --filter @vibe-game/client dev",
    "dev:ui": "pnpm --filter @vibe-game/ui dev",
    "dev:all": "pnpm -r --parallel run dev",
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "lint": "pnpm -r run lint",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\""
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild", "msgpackr-extract"]
  }
}
